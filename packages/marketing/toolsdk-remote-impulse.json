{
  "type": "mcp-server",
  "name": "Impulse",
  "packageName": "@toolsdk-remote/impulse",
  "description": "Hosted MCP for Impulse event pages, emails, guests, and check-in. Run your events by asking AI: create events, registration and invitation pages, emails, guest lists, and check-in in one chat. Impulse is a next-gen, AI-native event platform. Hosted MCP at https://mcp.impul.co/mcp (OAuth).",
  "readme": "https://www.impulse-interactive.com/product/mcp-server",
  "url": "https://github.com/impul-co/impulse-mcp",
  "runtime": "node",
  "license": "MIT",
  "logo": "https://www.impulse-interactive.com/impulse-icon-512.png",
  "author": "Impulse Interactive",
  "env": {},
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.impul.co/mcp",
      "auth": {
        "type": "oauth2",
        "scopes": [
          "events:metadata:read-write",
          "pages:read-write",
          "custom-domains:read-write",
          "email-templates:read-write",
          "guests:read-only",
          "guests:read-write",
          "access:scan",
          "texting-broadcast:read-write",
          "pictures:read-write"
        ]
      }
    }
  ]
}

  "author": "OutSend",
  "logo": "https://outsend.xyz/static/icons/icon-512.png",
  "env": {},
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://outsend.xyz/mcp",
      "auth": {
        "type": "oauth2",
        "scopes": ["mcp"]
      }
    }
  ]
}

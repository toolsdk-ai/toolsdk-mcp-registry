{
  "type": "mcp-server",
  "name": "Wheremind",
  "packageName": "@toolsdk-remote/wheremind",
  "description": "Hosted MCP server giving AI agents live places search, place details, geocoding, nearby search and directions.",
  "url": "https://wheremind.ai",
  "readme": "https://wheremind.ai/llms.txt",
  "runtime": "node",
  "env": {},

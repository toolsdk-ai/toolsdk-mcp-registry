{
  "type": "mcp-server",
  "name": "Save This One",
  "packageName": "@toolsdk-remote/save-this-one",
  "description": "Save, search, read, tag, and organize your bookmarks with OAuth sign-in.",
  "url": "https://savethisone.com/integrations/mcp",
  "readme": "https://savethisone.com/integrations/mcp",
  "runtime": "node",
  "env": {},
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.savethisone.com/mcp",
      "auth": {
        "type": "oauth2",
        "scopes": ["openid", "email", "profile"]
      }
    }
  ]
}

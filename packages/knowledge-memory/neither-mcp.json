{
  "type": "mcp-server",
  "name": "Neither",
  "packageName": "@neitherai/mcp-server",
  "description": "Selected project notes and documents for Cursor and Claude Desktop via local stdio MCP, with related retrieval and source evidence.",
  "url": "https://github.com/stonianua/neither-mcp",
  "readme": "https://github.com/stonianua/neither-mcp#readme",
  "runtime": "node",
  "license": "MIT",
  "env": {
    "NEITHER_API_KEY": {
      "description": "Neither workspace API key (sk_ctx_...).",
      "required": true,
      "secret": true
    },
    "NEITHER_API_BASE": {
      "description": "Neither API base URL.",
      "required": false,
      "secret": false,
      "default": "https://api.neither.online"
    }
  }
}
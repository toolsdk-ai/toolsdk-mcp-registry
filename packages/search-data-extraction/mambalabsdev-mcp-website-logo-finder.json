{
  "type": "mcp-server",
  "name": "Website Logo Finder",
  "packageName": "@mambalabsdev/mcp-website-logo-finder",
  "description": "MCP server for Website Logo Finder: company logo, favicon, icons, and brand colors from a domain.",
  "url": "https://github.com/mambalabsdev/mcp-website-logo-finder",
  "readme": "https://github.com/mambalabsdev/mcp-website-logo-finder#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}

{
  "type": "mcp-server",
  "name": "India MCA Company Data",
  "packageName": "@mambalabsdev/mcp-india-mca-company-data",
  "description": "MCP server for India MCA Company Data: Indian company and LLP master data and directors by CIN, LLPIN, or name.",
  "url": "https://github.com/mambalabsdev/mcp-india-mca-company-data",
  "readme": "https://github.com/mambalabsdev/mcp-india-mca-company-data#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}

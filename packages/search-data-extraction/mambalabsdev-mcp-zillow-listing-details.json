{
  "type": "mcp-server",
  "name": "Zillow Listing Details",
  "packageName": "@mambalabsdev/mcp-zillow-listing-details",
  "description": "MCP server for Zillow Listing Details. Zillow home details by URL, ZPID, address, or ZIP code. Runs on Apify. Clay-ready output.",
  "url": "https://github.com/mambalabsdev/mcp-zillow-listing-details",
  "readme": "https://github.com/mambalabsdev/mcp-zillow-listing-details#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}

{
  "type": "mcp-server",
  "name": "Spain Company Directory",
  "packageName": "@mambalabsdev/mcp-spain-company-directory",
  "description": "MCP server for Spain Company Directory on Apify: Spanish company data by name, CIF, sector, and status.",
  "url": "https://github.com/mambalabsdev/mcp-spain-company-directory",
  "readme": "https://github.com/mambalabsdev/mcp-spain-company-directory#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}

{
  "type": "mcp-server",
  "name": "Tiktok Video Stats",
  "packageName": "@mambalabsdev/mcp-tiktok-video-stats",
  "description": "MCP server for TikTok Video Stats. Plays, likes, comments, shares, and saves for TikTok posts by URL. Runs on Apify. Clay-ready output.",
  "url": "https://github.com/mambalabsdev/mcp-tiktok-video-stats",
  "readme": "https://github.com/mambalabsdev/mcp-tiktok-video-stats#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}

  "url": "https://github.com/mambalabsdev/mcp-wayback-machine-snapshots",
  "readme": "https://github.com/mambalabsdev/mcp-wayback-machine-snapshots#readme",
  "runtime": "node",
  "license": "MIT",
  "author": "Mamba Labs",
  "env": {
    "APIFY_TOKEN": {
      "description": "Apify API token from https://console.apify.com/account/integrations",
      "required": true,
      "secret": true
    }
  }
}
